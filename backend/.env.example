# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-char-hex
JWT_REFRESH_SECRET=replace-with-64-char-hex
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# App — set to your EC2 public IP or domain (used for CORS + email links)
# Examples:
#   http://13.233.45.67          (EC2 public IP, HTTP only)
#   https://safar.yourdomain.com (custom domain with HTTPS)
APP_BASE_URL=https://yourdomain.com
NODE_ENV=production
PORT=3000

# Cookie — set to your root domain, or leave empty if using an IP address
# If using IP:  COOKIE_DOMAIN=
# If domain:    COOKIE_DOMAIN=yourdomain.com
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true

# Email (Gmail: use an App Password, not your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# MongoDB — points to the mongodb container (do not change for Docker deployment)
MONGODB_URI=mongodb://mongodb:27017/Safar

# Mapbox (server-side geocoding)
MAPBOX_TOKEN=your-mapbox-token
