FROM node:22-alpine

# Required for bcrypt native compilation on Alpine
RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package*.json ./
RUN npm install

# Source (including docker-entrypoint.sh) is mounted via volume at runtime
EXPOSE 3000

ENTRYPOINT ["sh", "/app/docker-entrypoint.sh"]
CMD ["node", "--watch", "src/server.js"]
