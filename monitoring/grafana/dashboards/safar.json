{
  "uid": "safar-overview",
  "title": "Safar Overview",
  "description": "HTTP metrics, system health, and container logs for the Safar camping app",
  "tags": ["safar"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "graphTooltip": 1,
  "panels": [

    { "id": 1, "type": "row", "title": "Application", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },

    {
      "id": 2, "type": "timeseries", "title": "HTTP Request Rate (req/s)",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "safar-prom" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "safar-prom" },
        "expr": "sum(rate(http_requests_total{job=\"safar-backend\"}[5m])) by (route)",
        "legendFormat": "{{ route }}",
        "refId": "A"
      }],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      }
    },

    {
      "id": 3, "type": "stat", "title": "5xx Error Rate",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "safar-prom" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "safar-prom" },
        "expr": "sum(rate(http_requests_total{job=\"safar-backend\",status=~\"5..\"}[5m]))",
        "legendFormat": "errors/s",
        "refId": "A"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background", "graphMode": "area", "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red",    "value": 0.1  }
            ]
          }
        }
      }
    },

    {
      "id": 4, "type": "stat", "title": "MongoDB",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "safar-prom" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "safar-prom" },
        "expr": "mongodb_connected{job=\"safar-backend\"}",
        "legendFormat": "status",
        "refId": "A"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background", "graphMode": "none", "orientation": "auto",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red"   } } },
            { "type": "value", "options": { "1": { "text": "UP",   "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        }
      }
    },

    {
      "id": 5, "type": "timeseries", "title": "P95 Response Time (s) by route",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "safar-prom" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "safar-prom" },
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"safar-backend\"}[5m])) by (le, route))",
        "legendFormat": "{{ route }}",
        "refId": "A"
      }],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.5  },
              { "color": "red",    "value": 2.0  }
            ]
          }
        }
      }
    },

    { "id": 6, "type": "row", "title": "System", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },

    {
      "id": 7, "type": "gauge", "title": "CPU Usage %",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "safar-prom" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "safar-prom" },
        "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\"}[5m])) * 100)",
        "legendFormat": "CPU",
        "refId": "A"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70   },
              { "color": "red",    "value": 90   }
            ]
          }
        }
      }
    },

    {
      "id": 8, "type": "gauge", "title": "Memory Usage %",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "safar-prom" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "safar-prom" },
        "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})) * 100",
        "legendFormat": "Memory",
        "refId": "A"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 75   },
              { "color": "red",    "value": 90   }
            ]
          }
        }
      }
    },

    {
      "id": 9, "type": "gauge", "title": "Disk Usage % (/)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "safar-prom" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "safar-prom" },
        "expr": "(1 - (node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!=\"tmpfs\"})) * 100",
        "legendFormat": "Disk",
        "refId": "A"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70   },
              { "color": "red",    "value": 85   }
            ]
          }
        }
      }
    },

    { "id": 10, "type": "row", "title": "Logs", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 } },

    {
      "id": 11, "type": "logs", "title": "Container Logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "safar-loki" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "safar-loki" },
        "expr": "{project=\"safar\"}",
        "queryType": "range",
        "refId": "A"
      }],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }

  ]
}
